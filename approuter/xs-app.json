{
  "welcomeFile": "/presales-demos/webapp/index.html",
  "authenticationMethod": "route",
  "sessionTimeout": 30,
  "routes": [
    {
      "source": "^/demo/(.*)$",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/admin/(.*)$",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "scope": "$XSAPPNAME.DemoAdmin",
      "csrfProtection": false
    },
    {
      "source": "^(.*)$",
      "destination": "srv-api",
      "authenticationType": "xsuaa"
    }
  ]
}
