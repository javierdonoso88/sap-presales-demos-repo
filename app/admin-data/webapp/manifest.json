{
  "_version": "1.49.0",
  "sap.app": {
    "id": "sap.presales.admin",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": { "version": "1.0.0" },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "adminService": {
        "uri": "/admin/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": { "technology": "UI5" },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ushell": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": { "compact": true, "cozy": true },
    "models": {
      "": {
        "dataSource": "adminService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "sap.presales.admin.i18n.i18n" }
      }
    },
    "routing": {
      "routes": [
        { "pattern": ":?query:",                   "name": "TenantsList",          "target": "TenantsList"          },
        { "pattern": "Tenants({key}):?query:",     "name": "TenantsObjectPage",    "target": "TenantsObjectPage"    },
        { "pattern": "Solutions:?query:",          "name": "SolutionsList",        "target": "SolutionsList"        },
        { "pattern": "Solutions({key}):?query:",   "name": "SolutionsObjectPage",  "target": "SolutionsObjectPage"  },
        { "pattern": "Clients:?query:",            "name": "ClientsList",          "target": "ClientsList"          },
        { "pattern": "Clients({key}):?query:",     "name": "ClientsObjectPage",    "target": "ClientsObjectPage"    },
        { "pattern": "ComponentObjects:?query:",   "name": "ObjectsList",          "target": "ObjectsList"          },
        { "pattern": "ComponentObjects({key}):?query:", "name": "ObjectsObjectPage", "target": "ObjectsObjectPage"  }
      ],
      "targets": {
        "TenantsList": {
          "type": "Component", "id": "TenantsList", "name": "sap.fe.templates.ListReport",
          "options": { "settings": { "entitySet": "Tenants", "initialLoad": "Auto",
            "navigation": { "Tenants": { "detail": { "route": "TenantsObjectPage" } } } } }
        },
        "TenantsObjectPage": {
          "type": "Component", "id": "TenantsObjectPage", "name": "sap.fe.templates.ObjectPage",
          "options": { "settings": { "entitySet": "Tenants" } }
        },
        "SolutionsList": {
          "type": "Component", "id": "SolutionsList", "name": "sap.fe.templates.ListReport",
          "options": { "settings": { "entitySet": "Solutions", "initialLoad": "Auto",
            "navigation": { "Solutions": { "detail": { "route": "SolutionsObjectPage" } } } } }
        },
        "SolutionsObjectPage": {
          "type": "Component", "id": "SolutionsObjectPage", "name": "sap.fe.templates.ObjectPage",
          "options": { "settings": { "entitySet": "Solutions" } }
        },
        "ClientsList": {
          "type": "Component", "id": "ClientsList", "name": "sap.fe.templates.ListReport",
          "options": { "settings": { "entitySet": "Clients", "initialLoad": "Auto",
            "navigation": { "Clients": { "detail": { "route": "ClientsObjectPage" } } } } }
        },
        "ClientsObjectPage": {
          "type": "Component", "id": "ClientsObjectPage", "name": "sap.fe.templates.ObjectPage",
          "options": { "settings": { "entitySet": "Clients" } }
        },
        "ObjectsList": {
          "type": "Component", "id": "ObjectsList", "name": "sap.fe.templates.ListReport",
          "options": { "settings": { "entitySet": "ComponentObjects", "initialLoad": "Auto",
            "navigation": { "ComponentObjects": { "detail": { "route": "ObjectsObjectPage" } } } } }
        },
        "ObjectsObjectPage": {
          "type": "Component", "id": "ObjectsObjectPage", "name": "sap.fe.templates.ObjectPage",
          "options": { "settings": { "entitySet": "ComponentObjects" } }
        }
      }
    }
  }
}
