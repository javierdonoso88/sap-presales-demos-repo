{
  "name": "sap-presales-demos-repo",
  "version": "1.0.0",
  "description": "SAP Analytics Presales Demo Repository",
  "scripts": {
    "build:hana": "npx cds build --for hana",
    "build:ui": "npm ci --prefix ui && npm run build --prefix ui",
    "build:cf": "mbt build -t gen",
    "deploy:cf": "cf deploy gen/sap-presales-demos-repo_1.0.0.mtar"
  },
  "devDependencies": {
    "@sap/cds-dk": "^8"
  },
  "cds": {
    "build": {
      "tasks": [
        { "for": "hana", "src": "db", "options": { "model": ["db", "srv"] } },
        { "for": "nodejs", "src": "srv", "options": { "model": ["db", "srv"] } }
      ]
    }
  }
}
